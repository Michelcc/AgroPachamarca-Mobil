{
  "name": "agro",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "android": "expo run:android",
    "build:apk": "powershell -ExecutionPolicy Bypass -File android/build-apk.ps1",
    "install:apk": "powershell -ExecutionPolicy Bypass -File android/instalar-app.ps1",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.expo',{recursive:true,force:true})\"",
    "postinstall": "node scripts/patch-supabase-hermes.js",
    "gen:schema": "node scripts/gen-schema-sql.js",
    "train:crop-ml": "node scripts/train-crop-ml.js",
    "train:alert-ml": "node scripts/train-alert-ml.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.49.8",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
